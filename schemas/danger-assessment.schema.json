{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/spider-bench/schemas/danger-assessment.schema.json",
  "title": "DangerAssessment",
  "description": "Poland-specific medical-significance assessment for a taxon. Never auto-derived; missing evidence must be 'uncertain', never 'none_known'.",
  "type": "object",
  "required": ["taxonId", "geographicScope", "medicalSignificance", "rationale", "evidence", "reviewDate", "status"],
  "properties": {
    "taxonId": { "type": "integer", "minimum": 1 },
    "geographicScope": { "type": "string", "minLength": 1 },
    "medicalSignificance": {
      "type": "string",
      "enum": ["none_known", "minor_local_effects", "medically_significant", "uncertain"]
    },
    "exposureContext": { "type": ["string", "null"] },
    "rationale": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1 },
      "description": "Evidence-claim IDs supporting this assessment."
    },
    "reviewer": { "type": ["string", "null"] },
    "reviewDate": { "type": "string", "format": "date" },
    "confidence": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
    "status": {
      "type": "string",
      "enum": ["draft", "pending_review", "approved", "rejected"]
    }
  },
  "additionalProperties": false
}
