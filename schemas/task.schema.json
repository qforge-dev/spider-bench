{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spiders-dataset/benchmark-task.schema.json",
  "title": "Benchmark task row (generic envelope; v1 closed-set species ID)",
  "type": "object",
  "required": ["task_id", "task_type", "image_sha256", "image_s3_uri", "prompt", "correct_taxon"],
  "properties": {
    "task_id": {"type": "string"},
    "task_type": {"type": "string", "enum": ["species-id-closed", "abstain", "retrieval"]},
    "image_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "image_s3_uri": {"type": "string", "pattern": "^s3://"},
    "image_public_url": {"type": "string"},
    "prompt": {"type": "string"},
    "candidates": {"type": "array", "items": {"type": "string"}},
    "correct_taxon": {"type": "string"},
    "synonyms_accepted": {"type": "array", "items": {"type": "string"}, "default": []},
    "meta": {"type": "object", "default": {}}
  }
}
